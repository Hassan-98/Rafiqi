diff --git a/android/src/main/java/com/capacitorjs/plugins/localnotifications/NotificationStorage.java b/android/src/main/java/com/capacitorjs/plugins/localnotifications/NotificationStorage.java
index 74ab38faf48a2f11d94926eec83d4b65f8625988..e4ef8a1e83d322676c6266ea2d8180345b21131f 100644
--- a/android/src/main/java/com/capacitorjs/plugins/localnotifications/NotificationStorage.java
+++ b/android/src/main/java/com/capacitorjs/plugins/localnotifications/NotificationStorage.java
@@ -9,6 +9,7 @@ import java.util.List;
 import java.util.Map;
 import java.util.Set;
 import org.json.JSONException;
+import org.json.JSONObject;
 
 /**
  * Class used to abstract storage for notification data
@@ -129,6 +130,30 @@ public class NotificationStorage {
         return notification;
     }
 
+    /**
+     * [myzikr patch] Display id for a stored notification: `extra.displayId`
+     * (one stable id per reminder SERIES, so each new fire REPLACES the previous
+     * one in the shade instead of stacking), else the notification's own id.
+     */
+    public static int displayIdOf(JSONObject source, int fallback) {
+        if (source == null) return fallback;
+        JSONObject extra = source.optJSONObject("extra");
+        if (extra == null || !extra.has("displayId")) return fallback;
+        return extra.optInt("displayId", fallback);
+    }
+
+    /**
+     * [myzikr patch] Forget a notification after a tap/swipe ONLY if it is a
+     * one-shot. Upstream deleted repeating ones too, so a swiped daily reminder
+     * vanished from getPending() and was not restored after a reboot.
+     */
+    public void deleteIfOneShot(String id) {
+        JSObject json = getSavedNotificationAsJSObject(id);
+        JSONObject schedule = json == null ? null : json.optJSONObject("schedule");
+        boolean repeating = schedule != null && (schedule.optBoolean("repeats", false) || schedule.has("on") || schedule.has("every"));
+        if (!repeating) deleteNotification(id);
+    }
+
     /**
      * Remove the stored notifications
      */
