{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rafiqi",
  "mainBinaryName": "Rafiqi",
  "version": "../package.json",
  "identifier": "com.darkmon.myzikr",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Darkmon",
    "shortDescription": "رَفِيقِي",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["com.darkmon.myzikr"]
      }
    }
  }
}
