<?xml version="1.0" encoding="utf-8"?>
<!-- Sideload-flavor manifest overlay. READ_CALL_LOG is on Google Play's
     restricted-permission list (call-log access is for default dialer apps),
     so ONLY the direct-APK build declares it — never main/ or play/. It powers
     the opt-in «سجّل مكالماتي مع أرحامي تلقائياً» (SilatPhonePlugin.readCalls);
     on the play build SilatPhonePlugin.getStatus reports callLog:false and the
     switch stays hidden. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
</manifest>
