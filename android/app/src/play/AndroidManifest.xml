<?xml version="1.0" encoding="utf-8"?>
<!-- Play-flavor manifest overlay: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is on
     Google Play's restricted-permission list and gets the listing rejected.
     The sideload flavor keeps it (direct-APK users get the one-tap battery
     exclusion); the Play build must ask users to exclude the app manually via
     the system settings screen instead.
     USE_EXACT_ALARM is likewise reserved by Play policy for alarm/calendar
     apps; the Play build relies on SCHEDULE_EXACT_ALARM, which users grant once
     («المنبّهات والتذكيرات») — the notification center's status card prompts it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />
</manifest>
