<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth deep-link callback (Google → Supabase → app) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.darkmon.myzikr" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- Full-screen, incoming-call-style alarm screen -->
        <activity
            android:name=".FullScreenAlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=".fullscreenalarm"
            android:theme="@style/AppTheme.FullScreenAlarm" />

        <receiver
            android:name=".FullScreenAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.darkmon.myzikr.FULLSCREEN_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Re-arms full-screen alarms after reboot / update / clock change and, on
             boot, drops long-missed one-shot notifications BEFORE the Capacitor
             restore receiver would fire them all at once (ordered broadcast:
             the higher priority runs first). -->
        <receiver
            android:name=".AlarmRestoreReceiver"
            android:exported="false">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- «وضع الصلاة»: START/END alarms + «إنهاء الآن» / «صلّيت» / «في المسجد»
             (explicit intents only, so no intent-filter). -->
        <receiver
            android:name=".PrayerModeReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Background Quran / adhkar listening (screen off / app in background):
             MediaPlaybackService + MediaPlaybackPlugin. Play Console: declare the
             "Media playback" foreground-service type for this. -->
        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ── Home-screen widgets ─────────────────────────────────────── -->
        <receiver
            android:name=".widget.NextPrayerWidget"
            android:exported="false"
            android:label="@string/widget_next_prayer_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_prayer_info" />
        </receiver>

        <receiver
            android:name=".widget.PrayerTimesWidget"
            android:exported="false"
            android:label="@string/widget_prayer_times_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_prayer_times_info" />
        </receiver>

        <receiver
            android:name=".widget.TodayPrayersWidget"
            android:exported="false"
            android:label="@string/widget_today_prayers_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_prayers_info" />
        </receiver>

        <receiver
            android:name=".widget.ProgressWidget"
            android:exported="false"
            android:label="@string/widget_progress_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_progress_info" />
        </receiver>

        <receiver
            android:name=".widget.TasbeehWidget"
            android:exported="false"
            android:label="@string/widget_tasbeeh_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.darkmon.myzikr.widget.TASBEEH_INC" />
                <action android:name="com.darkmon.myzikr.widget.TASBEEH_RESET" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasbeeh_info" />
        </receiver>

        <receiver
            android:name=".widget.TasksWidget"
            android:exported="false"
            android:label="@string/widget_tasks_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks_info" />
        </receiver>

        <service
            android:name=".widget.TasksWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".widget.StudyWidget"
            android:exported="false"
            android:label="@string/widget_study_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_study_info" />
        </receiver>

        <receiver
            android:name=".widget.DashboardWidget"
            android:exported="false"
            android:label="@string/widget_dash_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_dashboard_info" />
        </receiver>

        <receiver
            android:name=".widget.CalendarWidget"
            android:exported="false"
            android:label="@string/widget_calendar_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calendar_info" />
        </receiver>

        <receiver
            android:name=".widget.QuranWidget"
            android:exported="false"
            android:label="@string/widget_quran_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quran_info" />
        </receiver>

        <receiver
            android:name=".widget.AdhkarWidget"
            android:exported="false"
            android:label="@string/widget_adhkar_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_adhkar_info" />
        </receiver>

        <receiver
            android:name=".widget.AwradWidget"
            android:exported="false"
            android:label="@string/widget_awrad_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_awrad_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location (prayer times / qibla) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications + alarms (prayer & dhikr reminders, adhan alarm) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Background listening: foreground service of type mediaPlayback (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- One-tap "ignore battery optimizations" system dialog (sideload build). NOTE:
         Google Play forbids this permission for most apps — remove it before any
         Play Store upload and fall back to the battery-settings screen instead. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Wake the screen for the adhan alarm (full-screen / heads-up) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <!-- «وضع الصلاة»: switch Do-not-disturb on for the prayer, then back
         (granted by the user in «الوصول إلى وضع عدم الإزعاج»). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Voice recite-test (التسميع) in the memorization screen.
         MODIFY_AUDIO_SETTINGS is REQUIRED alongside RECORD_AUDIO for the
         on-device Quran engine: it captures via WebView getUserMedia, and
         Capacitor's onPermissionRequest asks for both — an undeclared
         permission is auto-denied, which denies the whole mic request. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Android 11+: make the on-device speech recognition service visible -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
