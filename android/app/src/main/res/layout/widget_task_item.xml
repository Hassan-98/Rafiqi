<?xml version="1.0" encoding="utf-8"?>
<!-- One «مهامي» row: round check (ring when open, filled accent + tick when done), title,
     high-priority gold dot, steps done/total, time. An open task with steps adds up to 3 step
     lines under its title (small check + text, each its own tap target) and a «+n» line that
     opens the task. Colours set per row from the theme (TasksWidgetService). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ti_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="42dp">

        <FrameLayout
            android:id="@+id/ti_check"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:contentDescription="@string/widget_tasks_toggle">

            <ImageView android:id="@+id/ti_off" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/wg_circle_ring" android:contentDescription="@null" />
            <ImageView android:id="@+id/ti_on" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/wg_circle" android:visibility="gone" android:contentDescription="@null" />
            <ImageView android:id="@+id/ti_tick" android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="2dp" android:src="@drawable/wg_tick" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/ti_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textColor="@color/wg_text"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ti_pri"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/wg_circle"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/ti_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:maxLines="1"
            android:textColor="@color/wg_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ti_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/wg_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Step slots: indented to the title (check column 36dp + 4dp). -->
    <LinearLayout
        android:id="@+id/ti_s1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <FrameLayout android:layout_width="14dp" android:layout_height="14dp">
            <ImageView android:id="@+id/ti_s1_c" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/wg_circle_ring" android:contentDescription="@null" />
            <ImageView android:id="@+id/ti_s1_k" android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="1dp" android:src="@drawable/wg_tick" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/ti_s1_t"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/wg_text"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ti_s2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <FrameLayout android:layout_width="14dp" android:layout_height="14dp">
            <ImageView android:id="@+id/ti_s2_c" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/wg_circle_ring" android:contentDescription="@null" />
            <ImageView android:id="@+id/ti_s2_k" android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="1dp" android:src="@drawable/wg_tick" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/ti_s2_t"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/wg_text"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ti_s3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <FrameLayout android:layout_width="14dp" android:layout_height="14dp">
            <ImageView android:id="@+id/ti_s3_c" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/wg_circle_ring" android:contentDescription="@null" />
            <ImageView android:id="@+id/ti_s3_k" android:layout_width="match_parent" android:layout_height="match_parent"
                android:padding="1dp" android:src="@drawable/wg_tick" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/ti_s3_t"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/wg_text"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ti_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="26dp"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/wg_accent"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
