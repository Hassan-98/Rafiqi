<?xml version="1.0" encoding="utf-8"?>
<!-- «الأذكار» — the time-appropriate set (ring + status like Home's «الآن»), and the four sets as tinted chips (done ones marked ✓). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ad_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView android:id="@+id/ad_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_card" android:contentDescription="@null" />
    <ImageView android:id="@+id/ad_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_card_ring" android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/ad_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="12dp">
                <ImageView android:id="@+id/ad_ring_img" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wg_star8" android:contentDescription="@null" />
                <TextView
                    android:id="@+id/ad_pct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/wg_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:id="@+id/ad_star" android:layout_width="11dp" android:layout_height="11dp"
                        android:layout_marginEnd="5dp" android:src="@drawable/wg_star8" android:contentDescription="@null" />
                    <TextView
        android:id="@+id/ad_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="وقتها الآن"
        android:textColor="@color/wg_muted"
        android:textSize="11sp" />
                </LinearLayout>
                <TextView
        android:id="@+id/ad_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/wg_text"
        android:textSize="17sp"
        android:textStyle="bold" />
                <TextView
        android:id="@+id/ad_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/wg_muted"
        android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/ad_c_morning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp">
            <ImageView android:id="@+id/ad_c_morning_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_tile" android:contentDescription="@null" />
            <TextView
                android:id="@+id/ad_c_morning_t"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:text="الصباح"
                android:textColor="@color/wg_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ad_c_evening"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp">
            <ImageView android:id="@+id/ad_c_evening_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_tile" android:contentDescription="@null" />
            <TextView
                android:id="@+id/ad_c_evening_t"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:text="المساء"
                android:textColor="@color/wg_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ad_c_post"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp">
            <ImageView android:id="@+id/ad_c_post_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_tile" android:contentDescription="@null" />
            <TextView
                android:id="@+id/ad_c_post_t"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:text="بعد الصلاة"
                android:textColor="@color/wg_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ad_c_sleep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView android:id="@+id/ad_c_sleep_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_tile" android:contentDescription="@null" />
            <TextView
                android:id="@+id/ad_c_sleep_t"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:text="النوم"
                android:textColor="@color/wg_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
