<?xml version="1.0" encoding="utf-8"?>
<!-- «القرآن» — the Quran screen's hero card: featured khatma (page, %), today's wird and «تابع القراءة». -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView android:id="@+id/qr_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_hero" android:contentDescription="@null" />
    <ImageView android:id="@+id/qr_glow" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_hero_glow" android:contentDescription="@null" />
    <ImageView android:id="@+id/qr_star" android:layout_width="120dp" android:layout_height="120dp"
        android:layout_gravity="bottom|end" android:layout_marginBottom="-34dp" android:layout_marginEnd="-30dp"
        android:alpha="0.12" android:src="@drawable/wg_star8" android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
        android:id="@+id/qr_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/wg_on_accent_dim"
        android:textSize="12sp" />
        <TextView
        android:id="@+id/qr_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/wg_on_accent"
        android:textSize="24sp"
        android:textStyle="bold" />
        <TextView
        android:id="@+id/qr_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/wg_on_accent_dim"
        android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
        android:id="@+id/qr_wird"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/wg_on_accent"
        android:textSize="12sp"
        android:layout_weight="1" />
            <FrameLayout
            android:id="@+id/qr_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView android:id="@+id/qr_cta_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wg_pill" android:contentDescription="@null" />
            <TextView
                android:id="@+id/qr_cta_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:maxLines="1"
                android:text="تابع القراءة"
                android:textColor="@color/wg_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
