<?xml version="1.0" encoding="utf-8"?>
<!-- «إنجاز اليوم» — an app card with the progress ring (accent arc on the gold track). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView android:id="@+id/pg_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wg_card" android:contentDescription="@null" />
    <ImageView android:id="@+id/pg_ring" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/wg_card_ring" android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp">

            <ImageView
                android:id="@+id/pg_ring_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_progress_label" />

            <TextView
                android:id="@+id/pg_pct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="٠٪"
                android:textColor="@color/wg_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/pg_star" android:layout_width="11dp" android:layout_height="11dp"
                android:layout_marginEnd="5dp" android:src="@drawable/wg_star8" android:contentDescription="@null" />

            <TextView
                android:id="@+id/pg_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_progress_label"
                android:textColor="@color/wg_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/pg_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wg_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
