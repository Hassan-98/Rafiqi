<?xml version="1.0" encoding="utf-8"?>
<!-- «اليوم في التقويم» — Home's CalendarTodayCard, painted into card_img by CardPainter
     (RemoteViews can't use the app font, so the card is a bitmap). Opens the calendar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/card_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_calendar_title" />
</FrameLayout>
